---
import type { Project } from "../schemas/content";

interface Props {
  project: Project;
  layout?: "wide" | "narrow" | "standard";
}

const { project, layout = "standard" } = Astro.props;
const projectNumber = String(project.order).padStart(2, "0");
const hasLinks = project.repositoryUrl !== null || project.liveUrl !== null;
const responsiveSizes = {
  wide: "(max-width: 53.125rem) calc(100vw - clamp(2.5rem, 8vw, 3.5rem) - 2px), (max-width: 81rem) calc((100vw - 4.375rem) * 0.583), 715px",
  narrow: "(max-width: 53.125rem) calc(100vw - clamp(2.5rem, 8vw, 3.5rem) - 2px), (max-width: 81rem) calc((100vw - 5.25rem) * 0.417), 505px",
  standard: "(max-width: 53.125rem) calc(100vw - clamp(2.5rem, 8vw, 3.5rem) - 2px), (max-width: 81rem) calc((100vw - 4.75rem) / 2), 610px",
};
const srcset = project.cover.sources
  ? [
      ...project.cover.sources.map(({ src, width }) => `${src} ${width}w`),
      `${project.cover.src} ${project.cover.width}w`,
    ].join(", ")
  : undefined;
---

<article
  class:list={["project-card", `project-card--${layout}`]}
  data-project-id={project.id}
  data-project-layout={layout}
  aria-labelledby={`project-${project.slug}-title`}
>
  <div class="project-card__visual">
    <img
      src={project.cover.src}
      srcset={srcset}
      sizes={srcset ? responsiveSizes[layout] : undefined}
      alt={project.cover.alt}
      width={project.cover.width}
      height={project.cover.height}
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="project-card__body">
    <div class="project-card__meta">
      <span class="project-card__index">{projectNumber} / Featured</span>
      <span class="project-card__category">{project.category}</span>
    </div>
    <h3 id={`project-${project.slug}-title`}>{project.title}</h3>
    <p>{project.summary}</p>

    <ul class="project-card__stack" aria-label={`${project.title} technologies`}>
      {project.stack.map((technology) => <li>{technology}</li>)}
    </ul>

    {
      hasLinks ? (
        <div class="project-card__links" aria-label={`${project.title} links`}>
          {project.repositoryUrl && (
            <a href={project.repositoryUrl} target="_blank" rel="noreferrer">Repository ↗</a>
          )}
          {project.liveUrl && (
            <a href={project.liveUrl} target="_blank" rel="noreferrer">Live demo ↗</a>
          )}
        </div>
      ) : (
        <p class="project-card__pending">
          <span aria-hidden="true">Project links pending</span>
          <span class="visually-hidden">{project.title} — public project links pending review</span>
        </p>
      )
    }
  </div>
</article>
