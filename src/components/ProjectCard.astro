---
import type { Project } from "../schemas/content";

interface Props {
  project: Project;
  layout?: "wide" | "narrow" | "standard" | "reverse" | "feature";
}

const { project, layout = "standard" } = Astro.props;
const projectNumber = String(project.order).padStart(2, "0");
const dialogId = `project-${project.slug}-dialog`;
const hasLinks = project.repositoryUrl !== null || project.liveUrl !== null;
const responsiveSizes = {
  wide: "(max-width: 53.125rem) calc(100vw - clamp(2.5rem, 8vw, 3.5rem) - 2px), (max-width: 81rem) calc((100vw - 4.375rem) * 0.583), 715px",
  narrow: "(max-width: 53.125rem) calc(100vw - clamp(2.5rem, 8vw, 3.5rem) - 2px), (max-width: 81rem) calc((100vw - 5.25rem) * 0.417), 505px",
  standard: "(max-width: 53.125rem) calc(100vw - clamp(2.5rem, 8vw, 3.5rem) - 2px), (max-width: 81rem) calc((100vw - 4.75rem) / 2), 610px",
  reverse: "(max-width: 53.125rem) calc(100vw - clamp(2.5rem, 8vw, 3.5rem) - 2px), (max-width: 81rem) calc((100vw - 5.25rem) * 0.417), 505px",
  feature: "(max-width: 53.125rem) calc(100vw - clamp(2.5rem, 8vw, 3.5rem) - 2px), (max-width: 81rem) calc((100vw - 4.375rem) * 0.583), 715px",
};
const srcset = project.cover.sources
  ? [
      ...project.cover.sources.map(({ src, width }) => `${src} ${width}w`),
      `${project.cover.src} ${project.cover.width}w`,
    ].join(", ")
  : undefined;
const dialogImage = project.gallery?.[0] ?? project.cover;
const dialogSrcset = project.gallery ? undefined : srcset;
---

<article
  class:list={["project-card", `project-card--${layout}`]}
  data-project-id={project.id}
  data-project-layout={layout}
  aria-labelledby={`project-${project.slug}-title`}
>
  <div class="project-card__visual">
    <img
      src={project.cover.src}
      srcset={srcset}
      sizes={srcset ? responsiveSizes[layout] : undefined}
      alt={project.cover.alt}
      width={project.cover.width}
      height={project.cover.height}
      style={project.cover.objectPosition
        ? `object-position: ${project.cover.objectPosition}`
        : undefined}
      loading="lazy"
      decoding="async"
    />
    {project.evidenceCaption && <span class="project-card__evidence">{project.evidenceCaption}</span>}
  </div>

  <div class="project-card__body">
    <div class="project-card__meta">
      <span class="project-card__index">{projectNumber} / Featured</span>
      <span class="project-card__category">{project.category}</span>
    </div>
    <h3 id={`project-${project.slug}-title`}>
      <span data-project-static-title>{project.title}</span>
      <button
        class="project-card__open"
        type="button"
        aria-label={`Open ${project.title} project details`}
        aria-controls={dialogId}
        aria-haspopup="dialog"
        data-project-dialog-trigger
        data-analytics-project-id={project.slug}
        hidden
      >{project.title}<span aria-hidden="true"> ↗</span></button>
    </h3>
    <p>{project.summary}</p>

    <div class="project-card__fallback-details" data-project-dialog-fallback>
      <p class="project-card__fallback-label">Technologies</p>
      <ul aria-label={`${project.title} technologies`}>
        {project.stack.map((technology) => <li>{technology}</li>)}
      </ul>
      {hasLinks && (
        <div class="project-card__links" aria-label={`${project.title} links`}>
          {project.repositoryUrl && <a href={project.repositoryUrl} target="_blank" rel="noreferrer" data-analytics-event="project_repository_click" data-analytics-project-id={project.slug}>View repository</a>}
          {project.liveUrl && <a href={project.liveUrl} target="_blank" rel="noreferrer" data-analytics-event="project_demo_click" data-analytics-project-id={project.slug}>{project.slug === "discord-clone" ? "View project (sign-in required)" : "View project"}</a>}
        </div>
      )}
    </div>
  </div>
</article>

<dialog
  id={dialogId}
  class="project-dialog"
  data-project-dialog
  aria-labelledby={`${dialogId}-title`}
  aria-describedby={`${dialogId}-summary`}
>
  <div class="project-dialog__shell">
    <button
      class="project-dialog__close"
      type="button"
      data-project-dialog-close
      aria-label={`Close ${project.title} project details`}
    >×</button>

    <figure class="project-dialog__visual">
      <img
        src={dialogImage.src}
        srcset={dialogSrcset}
        sizes={dialogSrcset ? "(max-width: 53.125rem) calc(100vw - 3rem), 52rem" : undefined}
        alt={dialogImage.alt}
        width={dialogImage.width}
        height={dialogImage.height}
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="project-dialog__content">
      <p class="project-dialog__eyebrow">{projectNumber} / {project.category}</p>
      <h3 id={`${dialogId}-title`}>{project.title}</h3>
      <p id={`${dialogId}-summary`}>{project.summary}</p>

      <ul class="project-dialog__stack" aria-label={`${project.title} technologies`}>
        {project.stack.map((technology) => <li>{technology}</li>)}
      </ul>

      {
        hasLinks ? (
          <div class="project-dialog__links" aria-label={`${project.title} project links`}>
            {project.repositoryUrl && (
              <a
                href={project.repositoryUrl}
                target="_blank"
                rel="noreferrer"
                data-analytics-event="project_repository_click"
                data-analytics-project-id={project.slug}
              >View repository</a>
            )}
            {project.liveUrl && (
              <a
                href={project.liveUrl}
                target="_blank"
                rel="noreferrer"
                data-analytics-event="project_demo_click"
                data-analytics-project-id={project.slug}
              >{project.slug === "discord-clone" ? "View project (sign-in required)" : "View project"}</a>
            )}
          </div>
        ) : null
      }
    </div>
  </div>
</dialog>
