---
import type { Experience } from "../schemas/content";
import ExperienceRow from "./ExperienceRow.astro";

interface Props {
  experience: Experience[];
}

const { experience } = Astro.props;
---

<section class="content-section experience" id="experience" aria-labelledby="experience-title">
  <header class="section-header">
    <div class="section-header__intro">
      <h2 id="experience-title">Experience</h2>
      <p>Selected outcomes: systems integration, security automation, data engineering, and product work.</p>
    </div>
  </header>

  <div class="experience-list">
    {experience.map((entry) => <ExperienceRow experience={entry} />)}
  </div>
</section>
