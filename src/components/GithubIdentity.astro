---
import type { Site } from "../schemas/content";

interface Props {
  github: Site["github"];
}

const { github } = Astro.props;
---

<a
  class="github-identity"
  href={github.profileUrl}
  target="_blank"
  rel="me noreferrer"
  data-analytics-event="github_profile_click"
>
  <img
    class="github-identity__avatar"
    src={github.avatarFallback}
    srcset="/images/avatar-96.webp 96w, /images/avatar-128.webp 128w, /images/avatar.webp 256w"
    sizes="56px"
    alt={github.avatarAlt}
    width="56"
    height="56"
    loading="eager"
    decoding="async"
  />
  <span class="github-identity__copy">
    <span class="github-identity__label">GitHub profile</span>
    <strong>@{github.username}</strong>
    <span class="github-identity__hint">View code and repositories</span>
  </span>
  <span class="github-identity__arrow" aria-hidden="true">↗</span>
</a>
