---
import ProjectCard from "./ProjectCard.astro";
import type { Project } from "../schemas/content";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const layoutFor = (index: number) =>
  index === 0 ? "wide" : index === 1 ? "narrow" : index === 2 ? "reverse" : index === 3 ? "feature" : index === 4 ? "feature" : "standard";
---

<section class="content-section" id="work" aria-labelledby="work-title">
  <header class="section-header section-header--projects">
    <div class="section-header__intro">
      <h2 id="work-title">Selected projects</h2>
      <p>Production-minded work spanning real-time systems, AI, commerce, and data.</p>
    </div>
    <span class="section-header__count">
      {projects.length} selected {projects.length === 1 ? "project" : "projects"}
    </span>
  </header>

  <div class="project-grid">
    {projects.map((project, index) => <ProjectCard project={project} layout={layoutFor(index)} />)}
  </div>
</section>

<script>
  import "../scripts/project-dialogs";
</script>
