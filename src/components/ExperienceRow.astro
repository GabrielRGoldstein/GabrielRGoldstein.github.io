---
import type { Experience } from "../schemas/content";

interface Props {
  experience: Experience;
}

const { experience } = Astro.props;

function formatYear(value: string): string {
  return value.slice(0, 4);
}
---

<article
  class="experience-row"
  data-experience-id={experience.id}
  aria-labelledby={`${experience.id}-role`}
>
  <div class="experience-row__periods" aria-label="Employment periods">
    {
      experience.periods.map((period) => (
        <span class="experience-row__period">
          <time datetime={period.start}>{formatYear(period.start)}</time>
          <span>–</span>
          {period.end === null ? (
            <span>Present</span>
          ) : (
            <time datetime={period.end}>{formatYear(period.end)}</time>
          )}
        </span>
      ))
    }
  </div>
  <header class="experience-row__heading">
    <p class="experience-row__company">{experience.company}</p>
    <h3 id={`${experience.id}-role`}>{experience.role}</h3>
  </header>
  <p class="experience-row__summary">{experience.publicSummary}</p>
</article>
