---
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/portfolio.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Gabriel Goldstein — Software Engineer',
  description = 'Software engineer building dependable tools across systems integration, security automation, data engineering, and full-stack development.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#07170d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
